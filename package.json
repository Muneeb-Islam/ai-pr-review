{
  "name": "ai-pr-review-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI PR review platform: GitHub App, API, worker and dashboard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "acceptance": "vitest run --project acceptance",
    "pilot:report": "tsx --env-file-if-exists=.env scripts/pilot-report.ts",
    "acceptance:doc": "tsx scripts/acceptance-doc.ts",
    "test:chaos": "vitest run -c vitest.chaos.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "schema": "npm run schema -w @ai-pr-review/shared && npm run openapi -w @ai-pr-review/shared",
    "webhook:replay": "node --env-file-if-exists=.env scripts/replay-webhook.mjs",
    "github-app:register": "node --env-file-if-exists=.env scripts/register-github-app.mjs",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @ai-pr-review/db",
    "db:migrate": "npm run db:migrate -w @ai-pr-review/db",
    "db:seed": "npm run db:seed -w @ai-pr-review/db",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "credentials:rotate": "npm run credentials:rotate -w @ai-pr-review/worker",
    "credentials:revoke": "npm run credentials:revoke -w @ai-pr-review/worker --",
    "provider:smoke": "npm run provider:smoke -w @ai-pr-review/core",
    "review:fixtures": "npm run review:fixtures -w @ai-pr-review/core"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
