# Settings of the production stack (docker-compose.prod.yml). None of these is a secret: secrets are files under
# ./secrets (scripts/ops/init-secrets.sh). Copy to .env.production and edit. The full reference of every variable
# the services read is docs/operations.md, "Environment variables".

# The public address of the dashboard, as users type it (https, no trailing slash). The api is reached at the same
# address: the web server proxies /api, /auth and /webhooks to it. The GitHub App's callback URL is
# ${PUBLIC_URL}/auth/github/callback and its webhook URL is ${PUBLIC_URL}/webhooks/github.
PUBLIC_URL=https://review.example.com

# From the App's settings page on GitHub (docs/operations.md, "GitHub App").
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
# The App's URL slug (github.com/apps/<slug>); makes the "Install the App" link exact.
GITHUB_APP_SLUG=

# Host port of the web server. Put TLS in front of it.
WEB_PORT=8080

# Tag of the images this stack builds (a release number makes rollback a one-line change).
VERSION=latest

# Raise the version when you rotate ENCRYPTION_KEY (docs/operations.md, "Rotating the encryption key").
ENCRYPTION_KEY_VERSION=1

# How long finished runs are kept, in days, and the per-installation daily limits.
RETENTION_DAYS=90
QUOTA_RUNS_PER_DAY=200
QUOTA_TOKENS_PER_DAY=2000000
WORKER_CONCURRENCY=4
