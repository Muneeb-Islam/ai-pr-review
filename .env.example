# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Apps load it automatically (node --env-file-if-exists). Real environment variables win.
# Each app validates its variables at startup and reports only the NAMES of missing ones.

# --- Runtime ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public URL of the dashboard (OAuth redirects, CORS origin).
PUBLIC_URL=http://localhost:5173

# --- Infrastructure (matches docker-compose.yml; run `npm run db:up`) ------------------
DATABASE_URL=postgres://aipr:aipr@localhost:5432/aipr
REDIS_URL=redis://localhost:6379
# If 5432 is already used on your machine (a locally installed PostgreSQL), pick another host port
# for the container and use it in DATABASE_URL, e.g. POSTGRES_PORT=5544 and ...@localhost:5544/aipr.
# POSTGRES_PORT=5432

# --- Data retention and quotas (design §6, scope PL-08 and PL-11) -----------------------
# Finished runs older than this are deleted with their findings by the worker's cleanup job (Phase 14).
RETENTION_DAYS=90
# How often each worker runs the cleanup, in minutes.
# RETENTION_INTERVAL_MINUTES=360
# Per-installation limits. Proposed defaults; finalised with the quota logic (Phase 8).
QUOTA_RUNS_PER_DAY=200
QUOTA_TOKENS_PER_DAY=2000000

# --- GitHub App (Phase 3) ----------------------------------------------------------------
# Required by the api. Register a development App with `npm run github-app:register` (it writes these
# values to .env.github-app) or by hand: docs/github-app-setup.md.
# The private key may be given in double quotes with literal \n sequences.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The secret you set on the App's webhook; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# Largest webhook body the api accepts, in bytes (default 5 MiB).
# WEBHOOK_MAX_BODY_BYTES=5242880

# --- Dashboard sign-in, API and provider keys (Phase 4) ----------------------------------
# OAuth credentials of the same GitHub App (the register script writes them to .env.github-app).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL slug of the App (github.com/apps/<slug>) for the "Install the App" link; looked up from GitHub if unset.
# GITHUB_APP_SLUG=
# Public URL of this api. The App's callback URL must be ${API_PUBLIC_URL}/auth/github/callback.
API_PUBLIC_URL=http://localhost:3000
# Random secret of at least 32 characters: signs the session and sign-in cookies and derives CSRF tokens.
#   openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64: wraps the per-record data keys of stored provider keys (AES-256-GCM envelope).
#   openssl rand -base64 32
# Losing this key makes every stored provider key unreadable; back it up with the database dumps.
ENCRYPTION_KEY=
# Rotating the key: see apps/worker/src/rotation.ts. Raise the version, keep the old key as PREVIOUS,
# restart, run `npm run credentials:rotate`, then remove the PREVIOUS lines.
# ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_VERSION=
# Sessions end after this long idle, and in any case this long after sign-in.
# SESSION_IDLE_TIMEOUT_MINUTES=120
# SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# How long cached GitHub access (roles, repositories) is trusted before it is checked again.
# ACCESS_CACHE_TTL_SECONDS=600
# Requests per minute: per client IP (all /api and /auth routes) and per signed-in user.
# RATE_LIMIT_PER_IP_PER_MINUTE=300
# RATE_LIMIT_PER_USER_PER_MINUTE=120
# Set to true behind a reverse proxy so client IPs come from X-Forwarded-For (rate limiting).
# TRUST_PROXY=false

# --- Hardening and operations (Phase 15; reference: docs/operations.md) -----------------------------
# Any secret can come from a file instead: SESSION_SECRET_FILE=/run/secrets/session_secret (the production stack does).
# json (one object per line) or text. Default: json in production, text otherwise.
# LOG_FORMAT=text
# GET /metrics exists only when this is set (at least 16 characters); it needs "Authorization: Bearer <token>".
# METRICS_TOKEN=
# Webhook limits: per client address, bad signatures per address, events per installation (per minute).
# WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
# WEBHOOK_BAD_SIGNATURE_LIMIT_PER_MINUTE=20
# WEBHOOK_INSTALLATION_LIMIT_PER_MINUTE=300
# Runs that may wait in the queue, per installation and overall; one more is recorded as skipped (queue_limit).
# QUEUE_MAX_QUEUED_PER_INSTALLATION=100
# QUEUE_MAX_QUEUED_GLOBAL=2000
# Retention of the bookkeeping tables, and how often installations are reconciled with GitHub.
# AUDIT_RETENTION_DAYS=365
# WEBHOOK_DELIVERY_RETENTION_DAYS=14
# ACCESS_REFRESH_INTERVAL_MINUTES=60
# Migrations connect as this role when set (the table owner); the apps connect as DATABASE_URL, a plain role, so that the
# tenant row-level-security policies apply to them (docs/operations.md, "Database roles").
# MIGRATION_DATABASE_URL=

# --- Local provider testing only ---------------------------------------------------------
# In the platform, provider keys are entered in the dashboard and stored encrypted per
# installation. This variable is only for local scripts and tests from Phase 6 on.
# Only the key for the provider you use is needed (ANTHROPIC_API_KEY / OPENAI_API_KEY likewise).
DEEPSEEK_API_KEY=

# GitHub logins (comma-separated) that may open "Global AI setting" in the dashboard: one key and model per
# provider and the active provider, used by every repository that has not chosen its own.
PLATFORM_ADMINS=
