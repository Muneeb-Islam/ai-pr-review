{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["anthropic", "openai", "deepseek"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "review": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "comment_only",
          "type": "string",
          "enum": ["comment_only", "warn", "fail_on_threshold"]
        },
        "target_branches": {
          "default": ["main", "master"],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "draft_behavior": {
          "default": "summary_only",
          "type": "string",
          "enum": ["summary_only", "full", "skip"]
        },
        "minimum_severity": {
          "default": "medium",
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "minimum_confidence": {
          "default": 0.8,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_changed_files": {
          "default": 40,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_patch_characters": {
          "default": 120000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_inline_comments": {
          "default": 20,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": {},
      "type": "object",
      "properties": {
        "code_review": {
          "default": true,
          "type": "boolean"
        },
        "test_coverage": {
          "default": true,
          "type": "boolean"
        },
        "security": {
          "default": true,
          "type": "boolean"
        },
        "final_review": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "concurrency": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_requests": {
          "default": 20,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_total_tokens": {
          "default": 400000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "request_timeout_ms": {
          "default": 120000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "default": {},
      "type": "object",
      "properties": {
        "lcov_path": {
          "default": "coverage/lcov.info",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fork_prs": {
      "default": "skip",
      "type": "string",
      "enum": ["skip", "read_only"]
    },
    "ignore": {
      "default": ["dist/**", "coverage/**", "**/*.lock"],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "secret_paths": {
      "default": ["**/.env*"],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instructions": {
      "default": "",
      "type": "string"
    }
  },
  "required": ["provider", "model"],
  "additionalProperties": false,
  "title": "ai-pr-review-assistant configuration"
}
