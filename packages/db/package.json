{
  "name": "@ai-pr-review/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and tenant-scoped data access",
  "exports": {
    ".": "./src/index.ts",
    "./system": "./src/system/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@ai-pr-review/shared": "*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.11"
  }
}
